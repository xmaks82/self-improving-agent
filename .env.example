# ===========================================
# Self-Improving Agent Configuration
# ===========================================

# =========== API KEYS ===========

# Groq (FREE) - РЕКОМЕНДУЕТСЯ, очень быстрый
# Модели: llama-4-scout, llama-3.3-70b, qwen3-32b, kimi-k2, gpt-oss-120b
# https://console.groq.com/
GROQ_API_KEY=gsk_...

# Cerebras (FREE 1M tokens/day) - ультра-быстрый
# Модели: llama3.1-8b, qwen3-235b, gpt-oss-120b-cerebras, glm-4.7-cerebras
# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=...

# SambaNova (FREE) - САМЫЙ БЫСТРЫЙ (580 t/s на 70B!)
# Модели: llama-4-maverick, llama-3.3-70b, deepseek-v3.2, deepseek-r1, gpt-oss-120b-samba
# https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=...

# Zhipu AI - glm-4.5-flash и glm-4.7-flash бесплатные, остальные платные
# Модели: glm-4.5-flash (FREE), glm-4.7-flash (FREE), glm-4.7 ($0.60/$2.20), glm-4.5-air ($0.20/$1.10)
# https://open.bigmodel.cn/
ZHIPU_API_KEY=...

# Anthropic (paid) - для Claude моделей
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# =========== MODEL CONFIGURATION ===========

# Модель по умолчанию для основного агента
#
# БЕСПЛАТНЫЕ (Groq - рекомендуется):
#   llama-4-scout      - Llama 4 (16 experts)
#   llama-3.3-70b      - production, проверенная
#   qwen3-32b          - thinking mode
#   kimi-k2            - Moonshot AI
#   gpt-oss-120b       - OpenAI OSS 120B
#
# БЕСПЛАТНЫЕ (SambaNova - 580 t/s, самый быстрый!):
#   llama-4-maverick   - Llama 4 (128 experts)
#   samba-llama-70b    - Llama 3.3 70B (580 t/s!)
#   deepseek-v3.2      - DeepSeek V3.2
#   deepseek-r1        - DeepSeek R1 reasoning
#   gpt-oss-120b-samba - GPT-OSS 120B
#
# БЕСПЛАТНЫЕ (Cerebras - 1M/day, ультра-быстрый):
#   llama3.1-8b        - основная
#   qwen3-235b         - Qwen 3 235B MoE
#   gpt-oss-120b-cerebras - GPT-OSS 120B
#   glm-4.7-cerebras   - GLM 4.7
#
# БЕСПЛАТНЫЕ (Zhipu):
#   glm-4.5-flash      - GLM 4.5 Flash
#   glm-4.7-flash      - GLM 4.7 Flash
#
# ПЛАТНЫЕ (Anthropic):
#   claude-opus-4.6    - флагман, 200K ctx, 128K output
#   claude-sonnet-4.6  - баланс скорости и качества
#   claude-haiku       - быстрая и дешёвая
#   claude-opus-4.5    - legacy
#   claude-sonnet-4.5  - legacy
#
DEFAULT_MODEL=llama-4-scout

# Модели для pipeline улучшения (любая с поддержкой tools)
ANALYZER_MODEL=llama-3.3-70b
VERSIONER_MODEL=llama-3.3-70b

# Модель для детекции фидбека (быстрая)
FEEDBACK_MODEL=llama-4-scout

# =========== THRESHOLDS ===========

# Минимальная уверенность для детекции фидбека (0.0-1.0)
FEEDBACK_CONFIDENCE_THRESHOLD=0.8

# Минимальная уверенность для запуска улучшения (0.0-1.0)
IMPROVEMENT_CONFIDENCE_THRESHOLD=0.6

# =========== EMBEDDINGS (optional, hybrid memory) ===========
# Включает гибридный поиск памяти (вектор + ключевые слова, RRF). Опционально:
# если не задан EMBEDDINGS_URL — агент работает на ключевом поиске (из коробки).
# Любой OpenAI-совместимый /v1/embeddings endpoint: локальный llama-server,
# Ollama, OpenAI и т.д. Укажи СВОЙ адрес — ничего твоего в репозиторий не попадает.
# EMBEDDINGS_URL=http://localhost:8090/v1/embeddings
# EMBEDDINGS_MODEL=default
# EMBEDDINGS_TIMEOUT=10
# EMBEDDINGS_ENABLED=1   # авто-вкл при заданном URL; 0 чтобы принудительно выключить

# =========== LOGGING ===========

LOG_LEVEL=INFO

# OpenRouter (FREE tier available) - Qwen 3.6 Plus 1M context
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# =========== PROXY CONFIG (optional) ===========
# Route Claude requests through CLIProxyAPI proxy
# Uses your Claude subscription via OAuth instead of API billing
# See: https://github.com/router-for-me/CLIProxyAPI
# ANTHROPIC_BASE_URL=http://127.0.0.1:8318
# ANTHROPIC_PROXY_KEY=your-proxy-key
