# ===========================================
# Self-Improving Agent Configuration
# ===========================================
# Copy to .env and fill in ONE provider key (or run the FCM router).
# Everything below is optional — with no changes the agent uses DEFAULT_MODEL=fcm.

# =========== API KEYS ===========
# Uncomment and fill exactly the provider(s) you have. Leaving a placeholder
# UNCOMMENTED makes the agent think the key exists and then fail with 401 on the
# first message — so keep unused keys commented out.

# Groq (FREE, fast) — https://console.groq.com/
#GROQ_API_KEY=gsk_your_key_here

# Cerebras (FREE 1M tokens/day) — https://cloud.cerebras.ai/
#CEREBRAS_API_KEY=your_key_here

# SambaNova (FREE, very fast) — https://cloud.sambanova.ai/
#SAMBANOVA_API_KEY=your_key_here

# Zhipu AI (glm-4.5-flash / glm-4.7-flash free) — https://open.bigmodel.cn/
#ZHIPU_API_KEY=your_key_here

# OpenRouter (has a free tier) — https://openrouter.ai/keys
#OPENROUTER_API_KEY=sk-or-your_key_here

# Anthropic (paid) — https://console.anthropic.com/
#ANTHROPIC_API_KEY=sk-ant-your_key_here

# =========== MODEL CONFIGURATION ===========
# Default = fcm: a local FCM router that aggregates free models with health-probe
# + failover. Run your own router and point FCM_BASE_URL at it, OR set
# DEFAULT_MODEL to a concrete model from a provider whose key you filled above
# (e.g. llama-3.3-70b for Groq, llama-4-maverick for SambaNova, glm-4.7-flash for
# Zhipu). See README for the full model list per provider.
DEFAULT_MODEL=fcm

# Pipeline models (any tools-capable model). Default fcm; override per role.
ANALYZER_MODEL=fcm
VERSIONER_MODEL=fcm
FEEDBACK_MODEL=fcm

# FCM router endpoint (only used when a model is "fcm"). Defaults to localhost.
#FCM_BASE_URL=http://localhost:9999
#FCM_MODEL=auto
#FCM_API_KEY=

# =========== THRESHOLDS ===========
FEEDBACK_CONFIDENCE_THRESHOLD=0.8
IMPROVEMENT_CONFIDENCE_THRESHOLD=0.6

# =========== PATHS ===========
# Where data/ (prompts, sessions, memory) lives. Defaults to the repo root (or
# ~/.agent if data/ isn't found next to the code). Set explicitly if you moved it.
#AGENT_BASE_PATH=/path/to/agent

# =========== EMBEDDINGS (optional, hybrid memory) ===========
# Enables hybrid memory search (vector + keyword, RRF). If EMBEDDINGS_URL is unset
# the agent runs on keyword search alone (works out of the box). Any OpenAI-
# compatible /v1/embeddings endpoint: local llama-server, Ollama, OpenAI, etc.
#EMBEDDINGS_URL=http://localhost:8090/v1/embeddings
#EMBEDDINGS_MODEL=default
#EMBEDDINGS_TIMEOUT=10
#EMBEDDINGS_ENABLED=1   # auto-on when URL is set; 0 to force off

# =========== PROXY (optional) ===========
# Route Claude requests through CLIProxyAPI (use a Claude subscription via OAuth
# instead of API billing). See https://github.com/router-for-me/CLIProxyAPI
#ANTHROPIC_BASE_URL=http://127.0.0.1:8318
#ANTHROPIC_PROXY_KEY=your-proxy-key

# =========== LOGGING ===========
LOG_LEVEL=INFO
